{
  "name": "jwt-preview",
  "displayName": "JWT Preview",
  "description": "A clear, readable view of JWT token contents.",
  "version": "1.2.1",
  "publisher": "beatahumeniuk",
  "license": "MIT",
  "author": {
    "name": "Beata Humeniuk"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Beata-Humeniuk/jwt-preview.git"
  },
  "homepage": "https://github.com/Beata-Humeniuk/jwt-preview#readme",
  "bugs": {
    "url": "https://github.com/Beata-Humeniuk/jwt-preview/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "jwt",
    "token",
    "decode",
    "verify",
    "signature",
    "json web token",
    "offline",
    "local",
    "privacy"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jwtDecoder.open",
        "title": "Open Preview",
        "category": "JWT"
      },
      {
        "command": "jwtDecoder.decodeSelection",
        "title": "Decode Selected Token",
        "category": "JWT"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "jwtDecoder.decodeSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.3.0"
  }
}
